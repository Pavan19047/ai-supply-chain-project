# Environment Variables
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain_db
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/supply_chain_test_db

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
GEMINI_API_KEY=your-gemini-api-key-here

# ML Model Paths
YOLO_MODEL_PATH=models/best.pt
FORECASTING_MODEL_PATH=models/forecasting_model.pt
ANOMALY_MODEL_PATH=models/anomaly_model.joblib

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai-supply-chain.netlify.app